# Lenovo configuration options

config MACH_LENOVO
	bool "Lenovo device"
	depends on ARCH_MSM
	help
	  Support for Lenovo products

config MACH_LENOVO_PHAB
	bool "Lenovo PHAB"
	depends on ARCH_MSM8916
	select MACH_LENOVO
	help
	  Support for Lenovo PHAB variants

menu "Lenovo board selection"

config MACH_PHOENIX
	bool "phoenix board"
	select MACH_LENOVO_PHAB
	help
	  Support for the phoenix variants

endmenu
